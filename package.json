{
  "name": "@villagekit/ui",
  "version": "0.7.2",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "./src",
    "./dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build:pkg": "tsup src",
    "build:storybook": "storybook build",
    "deps": "depcheck",
    "dev": "storybook dev -p 6006",
    "lint": "biome check .",
    "publint": "publint",
    "format": "biome check --apply .",
    "format:unsafe": "biome check --apply-unsafe .",
    "test": "pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/villagekit/ui.git"
  },
  "author": "Michael Williams <hello@mikey.nz>",
  "license": "EUPL-1.2",
  "bugs": {
    "url": "https://github.com/villagekit/ui/issues"
  },
  "homepage": "https://github.com/villagekit/ui#readme",
  "dependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@ctrl/tinycolor": "^4.1.0",
    "lodash-es": "^4.17.21",
    "react-icons": "^5.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@storybook/addon-docs": "^9.0.6",
    "@storybook/addon-webpack5-compiler-swc": "^3.0.0",
    "@storybook/react": "^9.0.6",
    "@storybook/react-webpack5": "^9.0.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.165.0",
    "storybook": "^9.0.6"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "packageManager": "pnpm@9.9.0"
}
