{
  "name": "@villagekit/ui",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./mdx": {
      "types": "./src/mdx/index.ts",
      "source": "./src/mdx/index.ts",
      "import": "./src/mdx/index.ts",
      "default": "./src/mdx/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./mdx": {
        "types": "./dist/mdx/index.d.ts",
        "import": "./dist/mdx/index.js",
        "default": "./dist/mdx/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": ["./src", "./dist"],
  "sideEffects": false,
  "scripts": {
    "build:pkg": "tsup",
    "build:storybook": "storybook build",
    "deps": "depcheck",
    "dev": "storybook dev -p 6006",
    "lint": "biome check .",
    "publint": "publint",
    "format": "biome check --apply .",
    "format:unsafe": "biome check --apply-unsafe .",
    "prepack": "pnpm run build:pkg",
    "types": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/villagekit/ui.git"
  },
  "author": "Michael Williams <hello@mikey.nz>",
  "license": "EUPL-1.2",
  "bugs": {
    "url": "https://github.com/villagekit/ui/issues"
  },
  "homepage": "https://github.com/villagekit/ui#readme",
  "dependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@ctrl/tinycolor": "^4.1.0",
    "lodash-es": "^4.17.21",
    "react-icons": "^5.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/nextjs-vite": "^10.3.6",
    "@storybook/react": "^10.3.6",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.165.0",
    "next": "^15.0.0",
    "publint": "^0.3.18",
    "storybook": "^10.3.6",
    "tsup": "^8",
    "typescript": "^5.5.0",
    "vite": "^7.0.0"
  },
  "peerDependencies": {
    "next": "^15.0.0",
    "react": "^18.3.1 || ^19.1.0",
    "react-dom": "^18.3.1 || ^19.1.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "packageManager": "pnpm@9.9.0"
}
